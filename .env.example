# Primary API Provider (options: phimapi, nguonc, vsmov)
DEFAULT_API_PROVIDER=phimapi

# API Base URLs
PHIMAPI_BASE_URL=https://phimapi.com
NGUONC_BASE_URL=https://phim.nguonc.com/api
VSMOV_BASE_URL=https://vsmov.com/api

# Network request timeout in seconds
REQUEST_TIMEOUT=30

# Image disk cache
ENABLE_IMAGE_CACHE=true

# Logging
RUST_LOG=info
