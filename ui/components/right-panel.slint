import { Theme } from "../themes/theme.slint";
import { MovieItem } from "../models.slint";

export component RightPanel inherits Rectangle {
    in property <[MovieItem]> suggestions;
    in property <MovieItem> current-playing;
    in-out property <bool> is-playing: false;
    in-out property <string> selected-genre: "All";
    in-out property <string> current-episode-name: "Tập 01 (Full)";
    in-out property <string> cinema-time: "00:35:10 / 02:14:00";
    in-out property <int> cinema-progress-percent: 26;

    callback movie-selected(string);
    callback genre-selected(string);
    callback toggle-play();
    callback toggle-save(string);
    callback skip-10(bool);
    callback open-player();

    width: 290px;
    background: #090a0d88;

    // Left border line
    Rectangle {
        x: 0;
        width: 1px;
        height: 100%;
        background: Theme.border;
    }

    VerticalLayout {
        padding: 16px;
        spacing: 14px;

        // Panel 1: Now Streaming Cinema Preview Widget
        Rectangle {
            border-radius: Theme.radius-lg;
            background: @linear-gradient(135deg, Theme.primary.with-alpha(0.20) 0%, #151211 100%);
            border-width: 1px;
            border-color: Theme.primary.with-alpha(0.35);

            VerticalLayout {
                padding: 12px;
                spacing: 10px;

                // Widget Header
                HorizontalLayout {
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 6px;
                        alignment: center;
                        Text { text: "🎬"; font-size: 13px; vertical-alignment: center; }
                        Text {
                            text: "ĐANG PHÁT";
                            color: Theme.primary-light;
                            font-size: 10px;
                            font-weight: 800;
                            letter-spacing: 1.5px;
                            vertical-alignment: center;
                        }
                    }

                    // Heart Bookmark Button
                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 12px;
                        background: heart-touch.has-hover ? #ffffff18 : #00000000;

                        Text {
                            text: root.current-playing.is-saved ? "♥" : "♡";
                            color: root.current-playing.is-saved ? Theme.primary : Theme.text-muted;
                            font-size: 15px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        heart-touch := TouchArea {
                            clicked => { root.toggle-save(root.current-playing.slug); }
                        }
                    }
                }

                // 16:9 Cinema Thumbnail Banner
                Rectangle {
                    height: 100px;
                    border-radius: 8px;
                    background: #000000;
                    border-width: 1px;
                    border-color: #ffffff14;
                    clip: true;

                    Image {
                        width: 100%;
                        height: 100%;
                        source: @image-url("../../assets/images/hero_placeholder.png");
                        image-fit: cover;
                        opacity: 0.6;
                    }

                    if root.current-playing.has-poster : Image {
                        width: 100%;
                        height: 100%;
                        source: root.current-playing.poster;
                        image-fit: cover;
                        opacity: 0.45;
                    }

                    Rectangle {
                        width: 100%;
                        height: 100%;
                        background: @linear-gradient(180deg, #00000000 0%, #000000cc 100%);
                    }

                    // Quality Badge
                    Rectangle {
                        x: 8px;
                        y: 8px;
                        height: 18px;
                        border-radius: 3px;
                        background: Theme.primary;
                        HorizontalLayout {
                            padding-left: 6px; padding-right: 6px;
                            Text { text: "1080p FHD"; color: Theme.text-dark; font-size: 8px; font-weight: 800; vertical-alignment: center; }
                        }
                    }

                    // Stream Status
                    Rectangle {
                        x: parent.width - 70px;
                        y: 8px;
                        height: 18px;
                        border-radius: 3px;
                        background: #00000088;
                        border-width: 1px;
                        border-color: #ffffff22;
                        HorizontalLayout {
                            padding-left: 6px; padding-right: 6px;
                            Text {
                                text: root.is-playing ? "🟢 Đang phát" : "⏸ Tạm dừng";
                                color: root.is-playing ? #4ade80 : #f87171;
                                font-size: 8px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Center Play Overlay
                    Rectangle {
                        x: (parent.width - 36px) / 2;
                        y: (parent.height - 36px) / 2;
                        width: 36px;
                        height: 36px;
                        border-radius: 18px;
                        background: #000000aa;
                        border-width: 1.5px;
                        border-color: Theme.primary;

                        Text {
                            text: root.is-playing ? "⏸" : "▶";
                            color: Theme.primary-light;
                            font-size: 14px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            clicked => {
                                root.is-playing = !root.is-playing;
                                root.toggle-play();
                            }
                        }
                    }

                    // Bottom Title in Preview
                    Text {
                        x: 8px;
                        y: parent.height - 22px;
                        width: parent.width - 16px;
                        text: root.current-playing.title != "" ? root.current-playing.title : "Dune: Part Two";
                        color: #ffffff;
                        font-size: 11px;
                        font-weight: 700;
                        overflow: elide;
                    }
                }

                // Cinema Progress Timeline
                VerticalLayout {
                    spacing: 4px;

                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: root.cinema-time; color: #a1a1aa; font-size: 9px; font-weight: 600; }
                        Text { text: root.cinema-progress-percent + "%"; color: Theme.primary-light; font-size: 9px; font-weight: 700; }
                    }

                    Rectangle {
                        height: 4px;
                        background: #ffffff24;
                        border-radius: 2px;

                        Rectangle {
                            x: 0;
                            width: parent.width * (root.cinema-progress-percent / 100.0);
                            height: 100%;
                            background: Theme.primary;
                            border-radius: 2px;
                        }
                    }
                }

                // Movie Controls Row (Rewind 10s, Play/Pause, Forward 10s, Fullscreen Cinema)
                HorizontalLayout {
                    alignment: space-between;

                    // Rewind 10s
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 16px;
                        background: rw-mini-touch.has-hover ? #ffffff18 : #ffffff0c;
                        Text { text: "⏪"; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                        rw-mini-touch := TouchArea {
                            clicked => {
                                root.cinema-progress-percent = Math.max(0, root.cinema-progress-percent - 5);
                                root.skip-10(false);
                            }
                        }
                    }

                    // Play/Pause Circle
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 18px;
                        background: Theme.primary;

                        Text {
                            text: root.is-playing ? "⏸" : "▶";
                            color: Theme.text-dark;
                            font-size: 13px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        TouchArea {
                            clicked => {
                                root.is-playing = !root.is-playing;
                                root.toggle-play();
                            }
                        }
                    }

                    // Forward 10s
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 16px;
                        background: ff-mini-touch.has-hover ? #ffffff18 : #ffffff0c;
                        Text { text: "⏩"; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                        ff-mini-touch := TouchArea {
                            clicked => {
                                root.cinema-progress-percent = Math.min(100, root.cinema-progress-percent + 5);
                                root.skip-10(true);
                            }
                        }
                    }

                    // Open Full In-App Player Page
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 16px;
                        background: cinema-touch.has-hover ? Theme.primary.with-alpha(0.3) : #ffffff0c;
                        border-width: 1px;
                        border-color: Theme.primary.with-alpha(0.4);

                        Text {
                            text: "⛶";
                            font-size: 13px;
                            color: Theme.primary-light;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        cinema-touch := TouchArea {
                            clicked => { root.open-player(); }
                        }
                    }
                }

                // Direct Action Button: Vào Phòng Chiếu Phim
                Rectangle {
                    height: 28px;
                    border-radius: 14px;
                    background: enter-touch.has-hover ? Theme.primary.with-alpha(0.3) : #ffffff0d;
                    border-width: 1px;
                    border-color: Theme.primary.with-alpha(0.4);

                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        Text { text: "🎬 Vào Phòng Chiếu →"; color: Theme.primary-light; font-size: 10px; font-weight: 700; vertical-alignment: center; }
                    }

                    enter-touch := TouchArea {
                        clicked => { root.open-player(); }
                    }
                }
            }
        }

        // Panel 2: Picked for you (Curated Cinema Recommendations)
        Rectangle {
            border-radius: Theme.radius-lg;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                // Title
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Text { text: "✨"; font-size: 13px; vertical-alignment: center; }

                    VerticalLayout {
                        spacing: 1px;
                        Text {
                            text: "Gợi ý phim hay";
                            color: Theme.text-primary;
                            font-size: 12px;
                            font-weight: 700;
                        }
                        Text {
                            text: "Dành riêng cho bạn hôm nay";
                            color: Theme.text-muted;
                            font-size: 9px;
                        }
                    }
                }

                // Suggestions List
                for item in root.suggestions : Rectangle {
                    height: 50px;
                    border-radius: 8px;
                    background: sug-touch.has-hover ? #ffffff0d : #00000000;

                    // Row touch area
                    sug-touch := TouchArea {
                        clicked => { root.movie-selected(item.slug); }
                    }

                    HorizontalLayout {
                        padding: 4px;
                        spacing: 10px;
                        alignment: center;

                        // Mini Thumb
                        Rectangle {
                            width: 36px;
                            height: 44px;
                            border-radius: 5px;
                            background: Theme.card-bg;
                            clip: true;

                            Image {
                                width: 100%;
                                height: 100%;
                                source: @image-url("../../assets/images/poster_placeholder.png");
                                image-fit: cover;
                            }
                            if item.has-poster : Image {
                                width: 100%;
                                height: 100%;
                                source: item.poster;
                                image-fit: cover;
                            }
                        }

                        // Info
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;
                            alignment: center;

                            Text {
                                text: item.title;
                                color: Theme.text-primary;
                                font-size: 11px;
                                font-weight: 700;
                                overflow: elide;
                            }

                            Text {
                                text: item.genre + " · " + item.year;
                                color: Theme.text-muted;
                                font-size: 9px;
                                overflow: elide;
                            }
                        }

                        // Save / Bookmark action button
                        Rectangle {
                            width: 24px;
                            height: 24px;
                            border-radius: 12px;
                            background: item.is-saved ? Theme.primary.with-alpha(0.3) : save-touch.has-hover ? #ffffff24 : #ffffff14;
                            border-width: 1px;
                            border-color: item.is-saved ? Theme.primary : #ffffff18;

                            Text {
                                text: item.is-saved ? "✓" : "+";
                                color: item.is-saved ? Theme.primary-light : Theme.text-primary;
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            save-touch := TouchArea {
                                clicked => { root.toggle-save(item.slug); }
                            }
                        }
                    }
                }
            }
        }

        // Panel 3: Cinema Genres Cloud
        Rectangle {
            border-radius: Theme.radius-lg;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.border;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 6px;
                    Text { text: "🍿"; font-size: 12px; vertical-alignment: center; }
                    Text {
                        text: "Thể Loại Điện Ảnh";
                        color: Theme.text-primary;
                        font-size: 12px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                // Cloud of genres
                HorizontalLayout {
                    spacing: 6px;

                    Rectangle {
                        height: 26px;
                        border-radius: 13px;
                        background: root.selected-genre == "Chiếu Rạp" ? Theme.primary.with-alpha(0.25) : #ffffff0d;
                        border-width: 1px;
                        border-color: root.selected-genre == "Chiếu Rạp" ? Theme.primary : #ffffff12;

                        HorizontalLayout {
                            padding-left: 10px; padding-right: 10px;
                            Text { text: "Chiếu Rạp"; font-size: 10px; color: Theme.text-secondary; vertical-alignment: center; }
                        }
                        TouchArea { clicked => { root.selected-genre = "Chiếu Rạp"; root.genre-selected("phim-chieu-rap"); } }
                    }

                    Rectangle {
                        height: 26px;
                        border-radius: 13px;
                        background: root.selected-genre == "Hành Động" ? Theme.primary.with-alpha(0.25) : #ffffff0d;
                        border-width: 1px;
                        border-color: root.selected-genre == "Hành Động" ? Theme.primary : #ffffff12;

                        HorizontalLayout {
                            padding-left: 10px; padding-right: 10px;
                            Text { text: "Hành Động"; font-size: 10px; color: Theme.text-secondary; vertical-alignment: center; }
                        }
                        TouchArea { clicked => { root.selected-genre = "Hành Động"; root.genre-selected("hanh-dong"); } }
                    }

                    Rectangle {
                        height: 26px;
                        border-radius: 13px;
                        background: root.selected-genre == "Viễn Tưởng" ? Theme.primary.with-alpha(0.25) : #ffffff0d;
                        border-width: 1px;
                        border-color: root.selected-genre == "Viễn Tưởng" ? Theme.primary : #ffffff12;

                        HorizontalLayout {
                            padding-left: 10px; padding-right: 10px;
                            Text { text: "Viễn Tưởng"; font-size: 10px; color: Theme.text-secondary; vertical-alignment: center; }
                        }
                        TouchArea { clicked => { root.selected-genre = "Viễn Tưởng"; root.genre-selected("vien-tuong"); } }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;

                    Rectangle {
                        height: 26px;
                        border-radius: 13px;
                        background: root.selected-genre == "Kinh Dị" ? Theme.primary.with-alpha(0.25) : #ffffff0d;
                        border-width: 1px;
                        border-color: root.selected-genre == "Kinh Dị" ? Theme.primary : #ffffff12;

                        HorizontalLayout {
                            padding-left: 10px; padding-right: 10px;
                            Text { text: "Kinh Dị"; font-size: 10px; color: Theme.text-secondary; vertical-alignment: center; }
                        }
                        TouchArea { clicked => { root.selected-genre = "Kinh Dị"; root.genre-selected("kinh-di"); } }
                    }

                    Rectangle {
                        height: 26px;
                        border-radius: 13px;
                        background: root.selected-genre == "Anime" ? Theme.primary.with-alpha(0.25) : #ffffff0d;
                        border-width: 1px;
                        border-color: root.selected-genre == "Anime" ? Theme.primary : #ffffff12;

                        HorizontalLayout {
                            padding-left: 10px; padding-right: 10px;
                            Text { text: "Anime"; font-size: 10px; color: Theme.text-secondary; vertical-alignment: center; }
                        }
                        TouchArea { clicked => { root.selected-genre = "Anime"; root.genre-selected("hoat-hinh"); } }
                    }
                }
            }
        }
    }
}
