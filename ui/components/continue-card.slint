import { Theme } from "../themes/theme.slint";
import { MovieItem } from "../models.slint";

export component ContinueCard inherits Rectangle {
    in property <MovieItem> item;

    callback clicked();
    callback play-clicked();

    height: 125px;
    background: Theme.card-bg;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.border-accent : Theme.border;
    clip: true;

    // Backdrop Image
    Image {
        width: 100%;
        height: 100%;
        source: @image-url("../../assets/images/hero_placeholder.png");
        image-fit: cover;
    }

    if item.has-poster : Image {
        width: 100%;
        height: 100%;
        source: item.poster;
        image-fit: cover;
    }

    // Gradient Overlay
    Rectangle {
        width: 100%;
        height: 100%;
        background: @linear-gradient(90deg, #090a0ddd 0%, #090a0d66 60%, #00000022 100%);
    }

    // Title and Info
    VerticalLayout {
        x: 14px;
        y: parent.height - self.height - 18px;
        spacing: 4px;
        alignment: end;

        Text {
            text: item.title;
            color: Theme.text-primary;
            font-size: 13px;
            font-weight: 700;
            overflow: elide;
        }

        Text {
            text: item.progress + "% completed";
            color: Theme.text-muted;
            font-size: 10px;
        }
    }

    // Play Button Circle
    play-box := Rectangle {
        x: parent.width - self.width - 14px;
        y: parent.height - self.height - 16px;
        width: 32px;
        height: 32px;
        border-radius: 16px;
        background: play-touch.has-hover ? Theme.primary : #ffffffee;

        Text {
            text: "▶";
            color: play-touch.has-hover ? Theme.text-primary : Theme.text-dark;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        play-touch := TouchArea {
            clicked => { root.play-clicked(); }
        }
    }

    // Progress bar at the bottom
    Rectangle {
        y: parent.height - 3px;
        width: 100%;
        height: 3px;
        background: #ffffff22;

        // Active progress track
        Rectangle {
            x: 0;
            width: parent.width * (item.progress / 100.0);
            height: 100%;
            background: Theme.primary;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}
