import { Theme } from "../themes/theme.slint";
import { MovieItem } from "../models.slint";

export component HeroBanner inherits Rectangle {
    in property <MovieItem> featured;

    callback play-clicked();
    callback save-clicked();

    height: 330px;
    border-radius: Theme.radius-lg;
    background: Theme.card-bg;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;

    // Backdrop Image
    Image {
        width: 100%;
        height: 100%;
        source: @image-url("../../assets/images/hero_placeholder.png");
        image-fit: cover;
    }

    if featured.has-poster : Image {
        width: 100%;
        height: 100%;
        source: featured.poster;
        image-fit: cover;
    }

    // Cinematic Gradient Overlays (left dark fade + bottom fade)
    Rectangle {
        width: 100%;
        height: 100%;
        background: @linear-gradient(90deg, #090a0df2 0%, #090a0dcc 40%, #090a0d44 75%, #090a0d00 100%);
    }

    Rectangle {
        y: parent.height * 0.5;
        width: 100%;
        height: parent.height * 0.5;
        background: @linear-gradient(180deg, #00000000 0%, #090a0d99 100%);
    }

    // Hero Content
    VerticalLayout {
        x: 32px;
        y: 35px;
        width: 520px;
        spacing: 12px;
        alignment: center;

        // Tag: TRENDING #1 THIS WEEK
        HorizontalLayout {
            alignment: start;
            Rectangle {
                height: 26px;
                border-radius: 13px;
                background: #201811cc;
                border-width: 1px;
                border-color: Theme.primary-light.with-alpha(0.35);

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;
                    alignment: center;

                    Text {
                        text: "🔥 TRENDING #1 THIS WEEK";
                        color: Theme.primary-light;
                        font-size: 10px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Eyebrow
        Text {
            text: featured.origin_title != "" ? featured.origin_title : "THE CINEMATIC EVENT";
            color: #e9b58e;
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 2px;
        }

        // Main Title
        Text {
            text: featured.title != "" ? featured.title : "DUNE: PART TWO";
            color: Theme.text-primary;
            font-size: 38px;
            font-weight: 800;
            overflow: elide;
        }

        // Description / Tagline
        Text {
            text: featured.genre != "" ? featured.genre + " · " + featured.year + " · Rating ★ " + featured.rating : "Long live the fighters.";
            color: #d1d5db;
            font-size: 13px;
        }

        // Action Buttons
        HorizontalLayout {
            spacing: 12px;
            padding-top: 8px;

            // Watch Now Button
            watch-btn := Rectangle {
                height: 42px;
                border-radius: 21px;
                background: watch-touch.has-hover ? 
                    @linear-gradient(110deg, Theme.primary-hover 0%, Theme.primary 100%) : 
                    @linear-gradient(110deg, Theme.primary-light 0%, Theme.primary 100%);

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    spacing: 8px;
                    alignment: center;

                    Text {
                        text: "▶  Watch Now";
                        color: Theme.text-dark;
                        font-size: 12px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }

                watch-touch := TouchArea {
                    clicked => { root.play-clicked(); }
                }
            }

            // Watchlist Button
            save-btn := Rectangle {
                width: 42px;
                height: 42px;
                border-radius: 21px;
                background: save-touch.has-hover ? #ffffff33 : #ffffff1a;
                border-width: 1px;
                border-color: #ffffff33;

                Text {
                    text: featured.is_saved ? "♥" : "+";
                    color: featured.is_saved ? Theme.primary : Theme.text-primary;
                    font-size: 18px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                save-touch := TouchArea {
                    clicked => { root.save-clicked(); }
                }
            }
        }
    }

    // Carousel indicator dots at bottom center
    HorizontalLayout {
        x: (parent.width - self.width) / 2;
        y: parent.height - 22px;
        spacing: 6px;

        Rectangle {
            width: 22px;
            height: 6px;
            border-radius: 3px;
            background: Theme.primary;
        }
        Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: #ffffff55;
        }
        Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: #ffffff55;
        }
        Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: #ffffff55;
        }
    }
}
