import { Theme } from "../themes/theme.slint";

export component Topbar inherits Rectangle {
    in-out property <string> search-text: "";
    callback search-changed(string);
    callback search-submitted(string);

    height: 48px;

    HorizontalLayout {
        alignment: space-between;
        spacing: 16px;

        // Search Bar (Pill with glass effect)
        search-box := Rectangle {
            width: 580px;
            height: 42px;
            border-radius: 21px;
            background: Theme.panel;
            border-width: 1px;
            border-color: search-input.has-focus ? Theme.primary.with-alpha(0.5) : Theme.border;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 14px;
                spacing: 10px;
                alignment: center;

                Text {
                    text: "🔍";
                    font-size: 13px;
                    vertical-alignment: center;
                }

                search-input := TextInput {
                    text: root.search-text;
                    color: Theme.text-primary;
                    font-size: 13px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;

                    edited => {
                        root.search-text = self.text;
                        root.search-changed(self.text);
                    }

                    accepted => {
                        root.search-submitted(self.text);
                    }
                }

                if root.search-text == "" : Text {
                    text: "Search movies, series, actors...";
                    color: Theme.text-muted;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                // Keyboard shortcut badge
                Rectangle {
                    height: 22px;
                    border-radius: 5px;
                    background: #ffffff0e;
                    border-width: 1px;
                    border-color: #ffffff18;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        alignment: center;

                        Text {
                            text: "CTRL K";
                            color: Theme.text-muted;
                            font-size: 9px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Top Right Actions (Notification + User Avatar)
        HorizontalLayout {
            spacing: 16px;
            alignment: end;

            // Notification Bell
            Rectangle {
                width: 38px;
                height: 38px;
                border-radius: 19px;
                background: bell-touch.has-hover ? #ffffff14 : #ffffff08;
                border-width: 1px;
                border-color: Theme.border;

                Text {
                    text: "🔔";
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                bell-touch := TouchArea {}
            }

            // User Avatar
            Rectangle {
                width: 38px;
                height: 38px;
                border-radius: 19px;
                background: @linear-gradient(145deg, #ffd0a7 0%, #b96b45 100%);
                border-width: 2px;
                border-color: #ffffff26;

                Text {
                    text: "V";
                    color: #24150d;
                    font-size: 14px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
