import { Theme } from "../themes/theme.slint";

export component Topbar inherits Rectangle {
    in-out property <string> search-text: "";
    in property <bool> is-loading: false;
    callback search-changed(string);
    callback search-submitted(string);
    callback clear-search();

    height: 48px;

    HorizontalLayout {
        alignment: space-between;
        spacing: 16px;

        // Search Bar (Pill with glass effect & fluid auto layout)
        search-box := Rectangle {
            width: 580px;
            height: 42px;
            border-radius: 21px;
            background: Theme.panel;
            border-width: 1px;
            border-color: search-input.has-focus ? Theme.primary.with-alpha(0.6) : (root.is-loading ? Theme.primary-light.with-alpha(0.4) : Theme.border);

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 8px;
                spacing: 10px;

                // 1. Search Icon Button
                VerticalLayout {
                    alignment: center;
                    width: 24px;

                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 12px;
                        background: icon-touch.has-hover ? #ffffff1e : #00000000;

                        Text {
                            text: root.is-loading ? "⏳" : "🔍";
                            font-size: 14px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        icon-touch := TouchArea {
                            clicked => {
                                if root.search-text != "" {
                                    root.search-submitted(root.search-text);
                                } else {
                                    search-input.focus();
                                }
                            }
                        }
                    }
                }

                // 2. Middle Input and Placeholder (Fluid Stretch)
                input-area := Rectangle {
                    horizontal-stretch: 1;
                    clip: true;

                    if root.search-text == "" : Text {
                        width: 100%;
                        height: 100%;
                        text: "Tìm kiếm phim, diễn viên, thể loại...";
                        color: Theme.text-muted;
                        font-size: 13px;
                        vertical-alignment: center;
                    }

                    search-input := TextInput {
                        width: 100%;
                        height: 100%;
                        text <=> root.search-text;
                        color: Theme.text-primary;
                        font-size: 13px;
                        vertical-alignment: center;

                        edited => {
                            root.search-changed(self.text);
                        }

                        accepted => {
                            root.search-submitted(self.text);
                        }
                    }
                }

                // 3. Clear button when search query is entered
                if root.search-text != "" : VerticalLayout {
                    alignment: center;
                    width: 22px;

                    Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: 11px;
                        background: clear-touch.has-hover ? #ffffff2e : #ffffff14;

                        Text {
                            text: "✕";
                            font-size: 10px;
                            color: Theme.text-primary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        clear-touch := TouchArea {
                            clicked => {
                                root.search-text = "";
                                root.clear-search();
                            }
                        }
                    }
                }

                // 4. Clickable Search Submit Badge Button
                VerticalLayout {
                    alignment: center;

                    submit-btn := Rectangle {
                        height: 28px;
                        border-radius: 14px;
                        background: enter-touch.has-hover ? Theme.primary.with-alpha(0.35) : (root.is-loading ? Theme.primary.with-alpha(0.2) : (root.search-text != "" ? Theme.primary.with-alpha(0.22) : #ffffff0e));
                        border-width: 1px;
                        border-color: root.search-text != "" ? Theme.primary.with-alpha(0.55) : #ffffff18;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: center;

                            Text {
                                text: root.is-loading ? "Đang tìm..." : "Tìm kiếm ↵";
                                color: root.search-text != "" ? Theme.primary-light : Theme.text-muted;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }

                        enter-touch := TouchArea {
                            clicked => {
                                if root.search-text != "" {
                                    root.search-submitted(root.search-text);
                                } else {
                                    search-input.focus();
                                }
                            }
                        }
                    }
                }
            }
        }

        // Top Right Actions (Notification + User Avatar)
        HorizontalLayout {
            spacing: 16px;
            alignment: end;

            // Notification Bell
            Rectangle {
                width: 38px;
                height: 38px;
                border-radius: 19px;
                background: bell-touch.has-hover ? #ffffff14 : #ffffff08;
                border-width: 1px;
                border-color: Theme.border;

                Text {
                    text: "🔔";
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                bell-touch := TouchArea {}
            }

            // User Avatar
            Rectangle {
                width: 38px;
                height: 38px;
                border-radius: 19px;
                background: @linear-gradient(145deg, #ffd0a7 0%, #b96b45 100%);
                border-width: 2px;
                border-color: #ffffff26;

                Text {
                    text: "V";
                    color: #24150d;
                    font-size: 14px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
