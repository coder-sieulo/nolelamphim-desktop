import { Theme } from "../themes/theme.slint";

export component Topbar inherits Rectangle {
    in-out property <string> search-text: "";
    in property <bool> is-loading: false;
    callback search-changed(string);
    callback search-submitted(string);
    callback clear-search();

    height: 48px;

    HorizontalLayout {
        alignment: space-between;
        spacing: 16px;

        // Search Bar (Pill with glass effect & fluid auto layout)
        search-box := Rectangle {
            horizontal-stretch: 1;
            max-width: 640px;
            min-width: 220px;
            height: 42px;
            border-radius: 21px;
            background: Theme.panel;
            border-width: 1px;
            border-color: search-input.has-focus ? Theme.primary.with-alpha(0.6) : (root.is-loading ? Theme.primary-light.with-alpha(0.4) : Theme.border);

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 14px;
                spacing: 10px;
                alignment: center;

                if !root.is-loading : Text {
                    text: "🔍";
                    font-size: 13px;
                    vertical-alignment: center;
                }
                if root.is-loading : Text {
                    text: "⏳";
                    font-size: 13px;
                    vertical-alignment: center;
                }

                search-input := TextInput {
                    text: root.search-text;
                    color: Theme.text-primary;
                    font-size: 13px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;

                    edited => {
                        root.search-text = self.text;
                        root.search-changed(self.text);
                    }

                    accepted => {
                        root.search-submitted(self.text);
                    }
                }

                if root.search-text == "" : Text {
                    text: "Tìm kiếm phim, diễn viên, thể loại...";
                    color: Theme.text-muted;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                // Clear button when search query is entered
                if root.search-text != "" : Rectangle {
                    width: 20px;
                    height: 20px;
                    border-radius: 10px;
                    background: clear-touch.has-hover ? #ffffff2e : #ffffff14;

                    Text {
                        text: "✕";
                        font-size: 10px;
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    clear-touch := TouchArea {
                        clicked => {
                            root.search-text = "";
                            root.clear-search();
                        }
                    }
                }

                // Status Badge: Loading or ENTER hint
                if root.is-loading : Rectangle {
                    height: 22px;
                    border-radius: 11px;
                    background: Theme.primary.with-alpha(0.2);
                    border-width: 1px;
                    border-color: Theme.primary.with-alpha(0.4);

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        alignment: center;

                        Text {
                            text: "Đang tìm...";
                            color: Theme.primary-light;
                            font-size: 10px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }

                if !root.is-loading : Rectangle {
                    height: 22px;
                    border-radius: 5px;
                    background: #ffffff0e;
                    border-width: 1px;
                    border-color: #ffffff18;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        alignment: center;

                        Text {
                            text: "ENTER ↵";
                            color: Theme.text-muted;
                            font-size: 9px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Top Right Actions (Notification + User Avatar)
        HorizontalLayout {
            spacing: 16px;
            alignment: end;

            // Notification Bell
            Rectangle {
                width: 38px;
                height: 38px;
                border-radius: 19px;
                background: bell-touch.has-hover ? #ffffff14 : #ffffff08;
                border-width: 1px;
                border-color: Theme.border;

                Text {
                    text: "🔔";
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                bell-touch := TouchArea {}
            }

            // User Avatar
            Rectangle {
                width: 38px;
                height: 38px;
                border-radius: 19px;
                background: @linear-gradient(145deg, #ffd0a7 0%, #b96b45 100%);
                border-width: 2px;
                border-color: #ffffff26;

                Text {
                    text: "V";
                    color: #24150d;
                    font-size: 14px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
