import { Theme } from "themes/theme.slint";
import { MovieItem, PersonItem, EpisodeItem, GenreFilterItem } from "models.slint";
import { Sidebar } from "components/sidebar.slint";
import { Topbar } from "components/topbar.slint";
import { RightPanel } from "components/right-panel.slint";
import { HomePage } from "pages/home.slint";
import { DiscoverPage } from "pages/discover.slint";
import { MovieDetailPage } from "pages/movie-detail.slint";
import { LibraryPage } from "pages/library.slint";

import { PlayerPage } from "pages/player.slint";

export component AppWindow inherits Window {
    title: "Nolelamphim — Cinematic Movie Discovery";
    preferred-width: 1400px;
    preferred-height: 880px;
    min-width: 1080px;
    min-height: 720px;
    background: Theme.background;

    // Navigation State
    in-out property <string> active-page: "Home";
    in-out property <string> current-provider: "PhimAPI";
    in-out property <string> search-query-text: "";
    in-out property <bool> theater-mode: false;

    // Loading & Buffering States
    in-out property <bool> is-searching: false;
    in-out property <bool> discover-is-loading: false;
    in-out property <bool> detail-is-loading: false;
    in-out property <bool> player-is-buffering: false;

    // Data Models
    in property <MovieItem> hero-movie;
    in property <[MovieItem]> trending-movies;
    in property <[MovieItem]> continue-movies;
    in property <[MovieItem]> mood-movies;
    in property <[MovieItem]> discover-movies;
    in property <[GenreFilterItem]> discover-genres;
    in-out property <int> discover-current-page: 1;
    in-out property <int> discover-total-pages: 10;
    in property <[MovieItem]> library-saved-movies;
    in property <[MovieItem]> library-history-movies;
    in property <[MovieItem]> right-panel-suggestions;
    in property <MovieItem> current-playing-movie;
    in-out property <bool> is-playing: false;

    // Player Cinema Mode Data
    in property <EpisodeItem> current-episode;
    in property <[EpisodeItem]> current-episodes;
    in-out property <int> player-progress-seconds: 1450;
    in-out property <int> player-duration-seconds: 6600;
    in-out property <string> player-time-display: "00:24:10 / 01:50:00";
    in-out property <int> player-progress-percent: 22;
    in-out property <string> player-speed: "1.0x";
    in-out property <int> player-volume: 85;
    in-out property <string> player-server: "Server VIP #1";

    // Detail Page Data
    in property <MovieItem> detail-movie;
    in property <string> detail-synopsis;
    in property <string> detail-director;
    in property <[PersonItem]> detail-actors;
    in property <[EpisodeItem]> detail-episodes;
    in property <[string]> detail-keywords;

    // Callbacks to Rust Backend
    callback navigate(string);
    callback search-query(string);
    callback submit-search(string);
    callback select-movie(string);
    callback play-movie(string);
    callback play-episode(EpisodeItem);
    callback toggle-watchlist(string);
    callback change-provider(string);
    callback filter-genre(string);
    callback filter-type(string);
    callback change-page(int);
    callback prev-movie();
    callback next-movie();
    callback skip-10(bool);
    callback seek-percent(int);
    callback cycle-speed();
    callback open-fullscreen();
    callback next-episode();
    callback toggle-play();
    callback change-volume(int);
    callback switch-server(string);
    callback update-viewport-geometry(length, length, length, length);

    public function recompute-viewport() {
        if (root.active-page == "Player") {
            if (root.theater-mode) {
                root.update-viewport-geometry(
                    12px,
                    72px,
                    root.width - 24px,
                    max(520px, root.height - 160px)
                );
            } else {
                root.update-viewport-geometry(
                    248px,
                    148px,
                    root.width - 562px,
                    min(600px, max(420px, root.height - 380px))
                );
            }
        }
    }

    init => { root.recompute-viewport(); }
    changed width => { root.recompute-viewport(); }
    changed height => { root.recompute-viewport(); }
    changed theater-mode => { root.recompute-viewport(); }
    changed active-page => { root.recompute-viewport(); }

    HorizontalLayout {
        // Left Column: Navigation Sidebar (224px)
        if !root.theater-mode : Sidebar {
            active-page <=> root.active-page;
            current-provider <=> root.current-provider;
            navigate(page) => {
                root.active-page = page;
                root.navigate(page);
            }
            change-provider(p) => {
                root.current-provider = p;
                root.change-provider(p);
            }
            playlist-selected(slug) => {
                root.active-page = "Discover";
                root.filter-genre(slug);
            }
            upgrade-clicked => {
                root.active-page = "Library";
            }
            quick-action(action) => {
                if (action == "settings") {
                    root.active-page = "Library";
                } else if (action == "notifications") {
                    root.active-page = "Home";
                }
            }
        }

        // Center Column: Main Content (Fluid)
        VerticalLayout {
            padding-top: root.theater-mode ? 6px : 18px;
            padding-bottom: root.theater-mode ? 6px : 18px;
            padding-left: root.theater-mode ? 12px : 24px;
            padding-right: root.theater-mode ? 12px : 24px;
            spacing: root.theater-mode ? 8px : 16px;
            horizontal-stretch: 1;

            // Topbar
            if !root.theater-mode : Topbar {
                search-text <=> root.search-query-text;
                is-loading <=> root.is-searching;
                search-changed(q) => {
                    root.search-query(q);
                    if (q != "" && root.active-page != "Discover") {
                        root.active-page = "Discover";
                    }
                }
                search-submitted(q) => {
                    root.submit-search(q);
                    root.active-page = "Discover";
                }
                clear-search => {
                    root.search-query-text = "";
                    root.submit-search("");
                }
            }

            // View Switcher
            if root.active-page == "Home" : HomePage {
                featured-movie: root.hero-movie;
                trending-movies: root.trending-movies;
                continue-movies: root.continue-movies;
                mood-movies: root.mood-movies;
                movie-selected(slug) => { root.select-movie(slug); }
                play-movie(slug) => {
                    root.play-movie(slug);
                    root.active-page = "Player";
                }
                toggle-save(slug) => { root.toggle-watchlist(slug); }
                see-all(type) => {
                    if (type == "continue") {
                        root.active-page = "Library";
                    } else if (type == "trending") {
                        root.active-page = "Discover";
                        root.filter-type("all");
                    } else if (type == "mood") {
                        root.active-page = "Discover";
                        root.filter-genre("tinh-cam");
                    } else {
                        root.active-page = "Discover";
                    }
                }
            }

            if root.active-page == "Discover" : DiscoverPage {
                movies: root.discover-movies;
                genres: root.discover-genres;
                current-page <=> root.discover-current-page;
                total-pages <=> root.discover-total-pages;
                is-loading <=> root.discover-is-loading;
                search-query <=> root.search-query-text;
                search-changed(q) => {
                    root.search-query(q);
                }
                search-submitted(q) => {
                    root.submit-search(q);
                }
                genre-selected(slug) => { root.filter-genre(slug); }
                type-selected(t) => { root.filter-type(t); }
                movie-selected(slug) => { root.select-movie(slug); }
                play-movie(slug) => {
                    root.play-movie(slug);
                    root.active-page = "Player";
                }
                toggle-save(slug) => { root.toggle-watchlist(slug); }
                page-changed(p) => { root.change-page(p); }
            }

            if root.active-page == "Detail" : MovieDetailPage {
                movie: root.detail-movie;
                synopsis: root.detail-synopsis;
                director: root.detail-director;
                actors: root.detail-actors;
                episodes: root.detail-episodes;
                keywords: root.detail-keywords;
                is-loading <=> root.detail-is-loading;
                back-clicked => { root.active-page = "Home"; }
                play-episode(ep) => {
                    root.play-episode(ep);
                    root.active-page = "Player";
                }
                toggle-save(slug) => { root.toggle-watchlist(slug); }
                keyword-clicked(kw) => {
                    root.search-query-text = kw;
                    root.search-query(kw);
                    root.active-page = "Discover";
                }
            }

            if root.active-page == "Player" : PlayerPage {
                movie: root.current-playing-movie;
                current-episode: root.current-episode;
                episodes: root.current-episodes;
                window-height: root.height;
                is-playing <=> root.is-playing;
                is-buffering <=> root.player-is-buffering;
                theater-mode <=> root.theater-mode;
                progress-seconds <=> root.player-progress-seconds;
                duration-seconds <=> root.player-duration-seconds;
                time-display <=> root.player-time-display;
                progress-percent <=> root.player-progress-percent;
                playback-speed <=> root.player-speed;
                volume-level <=> root.player-volume;
                active-server <=> root.player-server;
                back-clicked => { root.active-page = "Detail"; }
                toggle-play => {
                    root.is-playing = !root.is-playing;
                    root.toggle-play();
                }
                change-volume(vol) => {
                    root.player-volume = vol;
                    root.change-volume(vol);
                }
                skip-10(fwd) => { root.skip-10(fwd); }
                seek-percent(p) => { root.seek-percent(p); }
                cycle-speed => { root.cycle-speed(); }
                select-episode(ep) => { root.play-episode(ep); }
                switch-server(srv) => {
                    root.player-server = srv;
                    root.switch-server(srv);
                }
                open-fullscreen => {
                    root.theater-mode = !root.theater-mode;
                    root.open-fullscreen();
                }
                toggle-save(slug) => { root.toggle-watchlist(slug); }
                next-episode => { root.next-episode(); }
            }

            if root.active-page == "Library" : LibraryPage {
                saved-movies: root.library-saved-movies;
                history-movies: root.library-history-movies;
                movie-selected(slug) => { root.select-movie(slug); }
                play-movie(slug) => {
                    root.play-movie(slug);
                    root.active-page = "Player";
                }
                toggle-save(slug) => { root.toggle-watchlist(slug); }
            }
        }

        // Right Column: Widgets & Mini-Player (290px)
        if !root.theater-mode : RightPanel {
            suggestions: root.right-panel-suggestions;
            current-playing: root.current-playing-movie;
            is-playing: root.is-playing;
            current-episode-name: root.current-episode.name != "" ? root.current-episode.name : "Tập 01 (Full)";
            cinema-time: root.player-time-display;
            cinema-progress-percent: root.player-progress-percent;
            movie-selected(slug) => { root.select-movie(slug); }
            genre-selected(g) => {
                root.active-page = "Discover";
                root.filter-genre(g);
            }
            toggle-play => {
                root.is-playing = !root.is-playing;
                root.toggle-play();
            }
            toggle-save(slug) => {
                root.toggle-watchlist(slug);
            }
            skip-10(fwd) => {
                root.skip-10(fwd);
            }
            open-player => {
                root.active-page = "Player";
            }
        }
    }
}
