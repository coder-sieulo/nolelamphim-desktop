import { Theme } from "../themes/theme.slint";
import { MovieItem, PersonItem, EpisodeItem } from "../models.slint";

export component MovieDetailPage inherits Flickable {
    in property <MovieItem> movie;
    in property <string> synopsis: "Đang tải nội dung phim...";
    in property <string> director: "Đang cập nhật";
    in property <[PersonItem]> actors;
    in property <[EpisodeItem]> episodes;
    in property <[string]> keywords;
    in-out property <string> active-server: "Server #1";

    callback back-clicked();
    callback play-episode(EpisodeItem);
    callback toggle-save(string);
    callback keyword-clicked(string);

    viewport-width: self.width;

    VerticalLayout {
        padding-top: 10px;
        padding-bottom: 50px;
        spacing: 24px;

        // Top Navigation: Back Button
        HorizontalLayout {
            alignment: start;

            Rectangle {
                height: 36px;
                border-radius: 18px;
                background: #ffffff12;
                border-width: 1px;
                border-color: Theme.border;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 16px;
                    spacing: 8px;
                    alignment: center;

                    Text { text: "←"; font-size: 14px; color: Theme.text-primary; vertical-alignment: center; }
                    Text { text: "Quay lại"; font-size: 12px; font-weight: 600; color: Theme.text-primary; vertical-alignment: center; }
                }

                TouchArea {
                    clicked => { root.back-clicked(); }
                }
            }
        }

        // Hero Info Section (Backdrop Banner + Poster + Metadata)
        Rectangle {
            height: 320px;
            border-radius: Theme.radius-lg;
            background: Theme.card-bg;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;

            Image {
                width: 100%;
                height: 100%;
                source: @image-url("../../assets/images/hero_placeholder.png");
                image-fit: cover;
            }

            Rectangle {
                width: 100%;
                height: 100%;
                background: @linear-gradient(90deg, #090a0df5 0%, #090a0dd0 45%, #090a0d77 100%);
            }

            HorizontalLayout {
                padding: 24px;
                spacing: 24px;

                // Poster
                Rectangle {
                    width: 180px;
                    height: 270px;
                    border-radius: Theme.radius-md;
                    background: #111216;
                    border-width: 1px;
                    border-color: Theme.border;
                    clip: true;

                    Image {
                        width: 100%;
                        height: 100%;
                        source: @image-url("../../assets/images/poster_placeholder.png");
                        image-fit: cover;
                    }

                    if root.movie.has-poster : Image {
                        width: 100%;
                        height: 100%;
                        source: root.movie.poster;
                        image-fit: cover;
                    }
                }

                // Info Details
                VerticalLayout {
                    spacing: 10px;
                    alignment: center;

                    // Badges (Quality, Year, Rating)
                    HorizontalLayout {
                        spacing: 8px;

                        Rectangle {
                            height: 22px;
                            border-radius: 4px;
                            background: Theme.primary;
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px;
                                Text { text: root.movie.quality != "" ? root.movie.quality : "HD"; color: Theme.text-dark; font-size: 10px; font-weight: 800; vertical-alignment: center; }
                            }
                        }

                        Rectangle {
                            height: 22px;
                            border-radius: 4px;
                            background: #ffffff18;
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px;
                                Text { text: root.movie.year; color: Theme.text-primary; font-size: 10px; font-weight: 600; vertical-alignment: center; }
                            }
                        }

                        Rectangle {
                            height: 22px;
                            border-radius: 4px;
                            background: #ffffff18;
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px;
                                Text { text: "★ " + root.movie.rating; color: Theme.rating-star; font-size: 10px; font-weight: 700; vertical-alignment: center; }
                            }
                        }
                    }

                    // Title
                    Text {
                        text: root.movie.title;
                        color: Theme.text-primary;
                        font-size: 28px;
                        font-weight: 800;
                        overflow: elide;
                    }

                    // Origin Title
                    Text {
                        text: root.movie.origin_title;
                        color: #c4c5cc;
                        font-size: 13px;
                        font-weight: 500;
                    }

                    // Director & Genres
                    Text {
                        text: "Đạo diễn: " + root.director + "  |  Thể loại: " + root.movie.genre;
                        color: Theme.text-muted;
                        font-size: 11px;
                    }

                    // Action Buttons
                    HorizontalLayout {
                        spacing: 12px;
                        padding-top: 6px;

                        // Play Episode 1 Button
                        Rectangle {
                            height: 38px;
                            border-radius: 19px;
                            background: @linear-gradient(110deg, Theme.primary-light 0%, Theme.primary 100%);

                            HorizontalLayout {
                                padding-left: 18px; padding-right: 18px;
                                spacing: 8px; alignment: center;
                                Text { text: "▶  Xem Phim"; color: Theme.text-dark; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                            }

                            TouchArea {
                                clicked => {
                                    if (root.episodes.length > 0) {
                                        root.play-episode(root.episodes[0]);
                                    }
                                }
                            }
                        }

                        // Watchlist Button
                        Rectangle {
                            height: 38px;
                            border-radius: 19px;
                            background: root.movie.is_saved ? Theme.primary : #ffffff18;
                            border-width: 1px;
                            border-color: Theme.border;

                            HorizontalLayout {
                                padding-left: 16px; padding-right: 16px;
                                spacing: 6px; alignment: center;
                                Text { text: root.movie.is_saved ? "♥ Đã Lưu" : "+ Yêu Thích"; color: Theme.text-primary; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                            }

                            TouchArea {
                                clicked => { root.toggle-save(root.movie.slug); }
                            }
                        }
                    }
                }
            }
        }

        // Synopsis Section
        VerticalLayout {
            spacing: 8px;

            Text {
                text: "Nội Dung Phim";
                color: Theme.text-primary;
                font-size: 16px;
                font-weight: 700;
            }

            Rectangle {
                border-radius: Theme.radius-md;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.border;

                VerticalLayout {
                    padding: 16px;
                    Text {
                        text: root.synopsis;
                        color: #d1d5db;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // Episodes Section
        VerticalLayout {
            spacing: 12px;

            Text {
                text: "Danh Sách Tập Phim";
                color: Theme.text-primary;
                font-size: 16px;
                font-weight: 700;
            }

            // Episode buttons wrap / row
            HorizontalLayout {
                spacing: 8px;

                for ep in root.episodes : Rectangle {
                    height: 36px;
                    border-radius: 8px;
                    background: ep-touch.has-hover ? Theme.primary.with-alpha(0.3) : #ffffff0e;
                    border-width: 1px;
                    border-color: ep-touch.has-hover ? Theme.primary : Theme.border;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        alignment: center;

                        Text {
                            text: ep.name;
                            color: ep-touch.has-hover ? Theme.primary-light : Theme.text-primary;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    ep-touch := TouchArea {
                        clicked => { root.play-episode(ep); }
                    }
                }
            }
        }

        // Cast & Crew Section (Peoples)
        if root.actors.length > 0 : VerticalLayout {
            spacing: 10px;

            Text {
                text: "Diễn Viên & Ê-kíp";
                color: Theme.text-primary;
                font-size: 16px;
                font-weight: 700;
            }

            HorizontalLayout {
                spacing: 14px;

                for actor in root.actors : Rectangle {
                    width: 120px;
                    height: 60px;
                    border-radius: Theme.radius-sm;
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.border;

                    HorizontalLayout {
                        padding: 8px;
                        spacing: 8px;
                        alignment: center;

                        Text { text: "👤"; font-size: 18px; vertical-alignment: center; }

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text { text: actor.name; color: Theme.text-primary; font-size: 11px; font-weight: 600; overflow: elide; }
                            Text { text: actor.role != "" ? actor.role : "Actor"; color: Theme.text-muted; font-size: 9px; overflow: elide; }
                        }
                    }
                }
            }
        }

        // Keywords & Tags Section
        if root.keywords.length > 0 : VerticalLayout {
            spacing: 8px;

            Text {
                text: "Từ Khóa Liên Quan";
                color: Theme.text-primary;
                font-size: 14px;
                font-weight: 700;
            }

            HorizontalLayout {
                spacing: 8px;

                for kw in root.keywords : Rectangle {
                    height: 26px;
                    border-radius: 13px;
                    background: #ffffff0a;
                    border-width: 1px;
                    border-color: #ffffff14;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        Text { text: "#" + kw; color: Theme.text-secondary; font-size: 10px; vertical-alignment: center; }
                    }

                    TouchArea {
                        clicked => { root.keyword-clicked(kw); }
                    }
                }
            }
        }
    }
}
