import { Theme } from "../themes/theme.slint";
import { MovieItem, GenreFilterItem } from "../models.slint";
import { MovieCard } from "../components/movie-card.slint";

export component DiscoverPage inherits Flickable {
    in property <[MovieItem]> movies;
    in property <[GenreFilterItem]> genres;
    in-out property <string> selected-genre: "All";
    in-out property <string> selected-type: "all";
    in property <int> current-page: 1;
    in property <int> total-pages: 10;
    in property <bool> is-loading: false;
    in-out property <string> search-query: "";

    callback genre-selected(string);
    callback type-selected(string);
    callback movie-selected(string);
    callback play-movie(string);
    callback toggle-save(string);
    callback page-changed(int);
    callback search-changed(string);
    callback search-submitted(string);

    viewport-width: self.width;

    VerticalLayout {
        padding-top: 10px;
        padding-bottom: 40px;
        spacing: 22px;

        // Title Header
        VerticalLayout {
            spacing: 6px;

            Text {
                text: root.search-query != "" ? "KẾT QUẢ TÌM KIẾM" : "YOUR NEXT FAVORITE STORY";
                color: #ffffff;
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 2.5px;
            }

            HorizontalLayout {
                spacing: 14px;
                alignment: start;

                Text {
                    text: root.search-query != "" ? ("Tìm kiếm: \"" + root.search-query + "\"") : "Discover Movies & Series";
                    color: Theme.text-primary;
                    font-size: 32px;
                    font-weight: 800;
                    vertical-alignment: center;
                }

                if root.search-query != "" : Rectangle {
                    height: 28px;
                    border-radius: 14px;
                    background: #ffffff14;
                    border-width: 1px;
                    border-color: #ffffff22;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        alignment: center;

                        Text {
                            text: "✕ Xóa bộ lọc tìm kiếm";
                            color: #ffffff;
                            font-size: 11px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    TouchArea {
                        clicked => {
                            root.search-submitted("");
                        }
                    }
                }
            }

            Text {
                text: root.search-query != ""
                    ? ("Hiển thị kết quả tìm kiếm cho \"" + root.search-query + "\" trên toàn bộ hệ thống nguồn phim.")
                    : "Filter through thousands of titles across multiple sources with high fidelity.";
                color: Theme.text-muted;
                font-size: 13px;
            }
        }

        // Category Type Bar (Phim Lẻ, Phim Bộ, Hoạt Hình, Chiếu Rạp)
        HorizontalLayout {
            spacing: 10px;

            Rectangle {
                height: 36px;
                border-radius: 18px;
                background: root.selected-type == "all" ? Theme.primary.with-alpha(0.25) : #ffffff0c;
                border-width: 1px;
                border-color: root.selected-type == "all" ? Theme.primary : Theme.border;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    Text { text: "Tất cả"; font-size: 12px; font-weight: 600; color: #ffffff; vertical-alignment: center; }
                }
                TouchArea { clicked => { root.selected-type = "all"; root.type-selected("all"); } }
            }

            Rectangle {
                height: 36px;
                border-radius: 18px;
                background: root.selected-type == "phim-le" ? Theme.primary.with-alpha(0.25) : #ffffff0c;
                border-width: 1px;
                border-color: root.selected-type == "phim-le" ? Theme.primary : Theme.border;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    Text { text: "Phim Lẻ"; font-size: 12px; font-weight: 600; color: #ffffff; vertical-alignment: center; }
                }
                TouchArea { clicked => { root.selected-type = "phim-le"; root.type-selected("phim-le"); } }
            }

            Rectangle {
                height: 36px;
                border-radius: 18px;
                background: root.selected-type == "phim-bo" ? Theme.primary.with-alpha(0.25) : #ffffff0c;
                border-width: 1px;
                border-color: root.selected-type == "phim-bo" ? Theme.primary : Theme.border;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    Text { text: "Phim Bộ"; font-size: 12px; font-weight: 600; color: #ffffff; vertical-alignment: center; }
                }
                TouchArea { clicked => { root.selected-type = "phim-bo"; root.type-selected("phim-bo"); } }
            }

            Rectangle {
                height: 36px;
                border-radius: 18px;
                background: root.selected-type == "hoat-hinh" ? Theme.primary.with-alpha(0.25) : #ffffff0c;
                border-width: 1px;
                border-color: root.selected-type == "hoat-hinh" ? Theme.primary : Theme.border;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    Text { text: "Hoạt Hình"; font-size: 12px; font-weight: 600; color: #ffffff; vertical-alignment: center; }
                }
                TouchArea { clicked => { root.selected-type = "hoat-hinh"; root.type-selected("hoat-hinh"); } }
            }

            Rectangle {
                height: 36px;
                border-radius: 18px;
                background: root.selected-type == "phim-chieu-rap" ? Theme.primary.with-alpha(0.25) : #ffffff0c;
                border-width: 1px;
                border-color: root.selected-type == "phim-chieu-rap" ? Theme.primary : Theme.border;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    Text { text: "Chiếu Rạp"; font-size: 12px; font-weight: 600; color: #ffffff; vertical-alignment: center; }
                }
                TouchArea { clicked => { root.selected-type = "phim-chieu-rap"; root.type-selected("phim-chieu-rap"); } }
            }
        }

        // Genre Tabs Row
        HorizontalLayout {
            spacing: 8px;

            for g in root.genres : Rectangle {
                height: 32px;
                border-radius: 16px;
                background: g.active ? Theme.primary.with-alpha(0.25) : #ffffff0a;
                border-width: 1px;
                border-color: g.active ? Theme.primary : #ffffff14;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    Text {
                        text: g.name;
                        color: #ffffff;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                TouchArea {
                    clicked => { root.genre-selected(g.slug); }
                }
            }
        }

        // Loading State View
        if root.is-loading : Rectangle {
            height: 320px;
            background: #ffffff04;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: #ffffff0d;

            VerticalLayout {
                alignment: center;
                spacing: 16px;

                // Pulsing Cinema Badge
                Rectangle {
                    width: 60px;
                    height: 60px;
                    border-radius: 30px;
                    background: @linear-gradient(135deg, Theme.primary.with-alpha(0.25) 0%, Theme.primary.with-alpha(0.06) 100%);
                    border-width: 2px;
                    border-color: Theme.primary;

                    Text {
                        text: "🎬";
                        font-size: 24px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                VerticalLayout {
                    spacing: 6px;
                    alignment: center;

                    Text {
                        text: root.search-query != "" ? ("Đang tìm kiếm: \"" + root.search-query + "\"...") : "Đang tải danh sách phim...";
                        color: Theme.text-primary;
                        font-size: 16px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "Đang truy xuất dữ liệu từ máy chủ và đồng bộ luồng phát...";
                        color: Theme.text-muted;
                        font-size: 12px;
                        horizontal-alignment: center;
                    }
                }

                // Visual Progress Pulse Bar
                Rectangle {
                    width: 180px;
                    height: 4px;
                    border-radius: 2px;
                    background: #ffffff14;

                    Rectangle {
                        x: 0;
                        width: 72px;
                        height: 4px;
                        border-radius: 2px;
                        background: @linear-gradient(90deg, Theme.primary-light 0%, Theme.primary 100%);
                    }
                }
            }
        }

        // Empty State (When not loading and 0 movies found)
        if !root.is-loading && root.movies.length == 0 : Rectangle {
            height: 260px;
            background: #ffffff03;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: #ffffff0a;

            VerticalLayout {
                alignment: center;
                spacing: 12px;

                Text { text: "🔍"; font-size: 38px; horizontal-alignment: center; }

                Text {
                    text: root.search-query != ""
                        ? ("Không tìm thấy phim phù hợp cho từ khóa \"" + root.search-query + "\"")
                        : "Không có phim nào trong danh mục này";
                    color: Theme.text-primary;
                    font-size: 16px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.search-query != ""
                        ? "Gợi ý: Thử tìm theo tên không dấu, tên tiếng Anh, hoặc bấm chọn thể loại bên trên."
                        : "Vui lòng chọn danh mục hoặc thể loại khác từ danh sách phía trên.";
                    color: Theme.text-muted;
                    font-size: 12px;
                    horizontal-alignment: center;
                }
            }
        }

        // Responsive Auto-Layout Movies Grid
        if !root.is-loading && root.movies.length > 0 : Rectangle {
            property <length> gap-x: 16px;
            property <length> gap-y: 20px;
            property <length> min-item-w: 150px;
            property <int> cols: Math.max(2, Math.floor((self.width + gap-x) / (min-item-w + gap-x)));
            property <length> item-w: (self.width - (cols - 1) * gap-x) / cols;
            property <length> item-h: item-w * 1.42 + 48px;

            height: Math.ceil(root.movies.length / cols) * (item-h + gap-y);

            for item[idx] in root.movies : MovieCard {
                x: (idx - Math.floor(idx / cols) * cols) * (item-w + gap-x);
                y: Math.floor(idx / cols) * (item-h + gap-y);
                width: item-w;
                height: item-h;
                item: item;
                clicked => { root.movie-selected(item.slug); }
                play-clicked => { root.play-movie(item.slug); }
                save-clicked => { root.toggle-save(item.slug); }
            }
        }

        // Pagination Bar
        HorizontalLayout {
            alignment: center;
            spacing: 16px;
            padding-top: 20px;

            // Prev Button
            Rectangle {
                width: 80px;
                height: 34px;
                border-radius: 17px;
                background: #ffffff0e;
                border-width: 1px;
                border-color: Theme.border;

                Text {
                    text: "← Prev";
                    color: #ffffff;
                    font-size: 11px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => {
                        if (root.current-page > 1) {
                            root.page-changed(root.current-page - 1);
                        }
                    }
                }
            }

            Text {
                text: "Page " + root.current-page + " of " + root.total-pages;
                color: #ffffff;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
            }

            // Next Button
            Rectangle {
                width: 80px;
                height: 34px;
                border-radius: 17px;
                background: #ffffff0e;
                border-width: 1px;
                border-color: Theme.border;

                Text {
                    text: "Next →";
                    color: #ffffff;
                    font-size: 11px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    clicked => {
                        if (root.current-page < root.total-pages) {
                            root.page-changed(root.current-page + 1);
                        }
                    }
                }
            }
        }
    }
}
