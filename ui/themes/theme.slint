export global Theme {
    // Backgrounds & Panels
    in property <color> background: #090a0d;
    in property <color> background-deep: #050608;
    in property <color> panel: #ffffff.with-alpha(0.055);
    in property <color> panel-hover: #ffffff.with-alpha(0.09);
    in property <color> panel-active: #ffffff.with-alpha(0.14);
    in property <color> panel-secondary: #151518;
    in property <color> card-bg: #131418;
    
    // Borders & Dividers
    in property <color> border: #ffffff.with-alpha(0.105);
    in property <color> border-subtle: #ffffff.with-alpha(0.06);
    in property <color> border-accent: #ff781f.with-alpha(0.35);

    // Accents (Cinematic Orange)
    in property <color> primary: #ff781f;
    in property <color> primary-hover: #ffa34d;
    in property <color> primary-light: #ffad65;
    in property <color> primary-glow: #ff781f.with-alpha(0.25);
    
    // Typography
    in property <color> text-primary: #f7f6f3;
    in property <color> text-secondary: #a6a6ae;
    in property <color> text-muted: #70717a;
    in property <color> text-dark: #15100c;

    // Badges & Status
    in property <color> rating-star: #ffc17e;
    in property <color> success: #22c55e;
    in property <color> error: #ef4444;

    // Dimensions & Radii
    in property <length> radius-sm: 8px;
    in property <length> radius-md: 12px;
    in property <length> radius-lg: 16px;
    in property <length> radius-xl: 22px;
    in property <length> radius-full: 9999px;
}
